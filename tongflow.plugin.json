{
    "plugin": {
        "name": "Spark-X2.5",
        "description": "Spark-X2.5-4B (iFlytek, on-device LLM, native 1M-token context) — generate / rewrite / combine text.",
        "icon": "/plugins/tongflow-modal-spark-x25.svg"
    },
    "env": [
        {
            "key": "MODAL_TOKEN_ID",
            "required": true,
            "description": "Modal token id",
            "url": "https://modal.com/settings/tokens"
        },
        {
            "key": "MODAL_TOKEN_SECRET",
            "required": true,
            "description": "Modal token secret (paired with MODAL_TOKEN_ID)"
        },
        {
            "key": "TONGFLOW_MODAL_CALL_TIMEOUT_S",
            "default": "2400",
            "description": "Max seconds to wait for a Modal call"
        }
    ]
}
